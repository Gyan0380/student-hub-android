<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/blue" android:titleTextColor="@color/white"/>
    <TextView android:id="@+id/emptyNotifications" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="32dp" android:gravity="center" android:text="No notifications yet" android:textColor="@color/muted" android:visibility="gone"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerNotifications" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="12dp"/>
</LinearLayout>
