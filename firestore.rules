rules_version = '2';

// -----------------------------------------------------------------------
// StudentHub Firestore Security Rules
//
// NOTE on Chats/{roomId}/Messages authorization:
// Firestore rules cannot execute string-slugify logic, so authorized
// class chat room ids are precomputed and stored on the user's document
// as an array field `classRooms` (e.g. ["class-grade-10-a", "class-grade-11-b"]).
// This array is kept in sync by the `syncClassRooms` callable and the
// `onUserWriteSyncClassRooms` Cloud Function trigger whenever
// `classLevel` / `classAccess` change. Rules simply check membership in
// this precomputed array.
// -----------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/Users/$(uid)).data;
    }

    function myRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/Users/$(request.auth.uid))
        ? userDoc(request.auth.uid).role
        : null;
    }

    function isAdmin() {
      return myRole() == 'Admin' || myRole() == 'Owner';
    }

    function isOwner() {
      return myRole() == 'Owner';
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function notBanned() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/Users/$(request.auth.uid))
        && userDoc(request.auth.uid).isBanned != true;
    }

    function timeoutExpired() {
      let u = userDoc(request.auth.uid);
      return !('timeoutExpiry' in u) || u.timeoutExpiry == null || u.timeoutExpiry < request.time;
    }

    // ---------- Users ----------
    match /Users/{uid} {
      allow read: if isSignedIn();

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ['Student', 'Teacher']
        && request.resource.data.isBanned == false;

      // Self-update: only allowed to touch profile fields, never protected ones.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fullName', 'dob', 'schoolName', 'bio', 'profilePhoto', 'classLevel'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.isBanned == resource.data.isBanned
        && request.resource.data.get('timeoutExpiry', null) == resource.data.get('timeoutExpiry', null)
        && request.resource.data.get('classAccess', []) == resource.data.get('classAccess', [])
      || (isAdmin() && !isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['isBanned', 'timeoutExpiry', 'classAccess', 'classRooms'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role)
      || (isOwner()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['isBanned', 'timeoutExpiry', 'classAccess', 'classRooms', 'role']));

      allow delete: if isOwner();

      match /FcmTokens/{token} {
        allow read, write: if isSelf(uid);
      }
    }

    // ---------- Usernames (uniqueness reservation) ----------
    match /Usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/Usernames/$(username));
      allow update, delete: if isAdmin();
    }

    // ---------- Chats ----------
    match /Chats/{roomId}/Messages/{msgId} {
      function roomAuthorized() {
        return roomId == 'global' || roomId == 'anonymous'
          || isAdmin()
          || (isSignedIn()
              && exists(/databases/$(database)/documents/Users/$(request.auth.uid))
              && roomId in userDoc(request.auth.uid).get('classRooms', []));
      }

      allow read: if isSignedIn() && roomAuthorized();

      allow create: if isSignedIn()
        && notBanned()
        && timeoutExpired()
        && request.resource.data.senderId == request.auth.uid
        && roomAuthorized()
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;

      allow update: if (isSignedIn() && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000)
        || isAdmin();

      allow delete: if (isSignedIn() && resource.data.senderId == request.auth.uid) || isAdmin();
    }

    // ---------- Notifications ----------
    match /Notifications/{id} {
      allow read: if isSignedIn()
        && (resource.data.toUid == 'all' || resource.data.toUid == request.auth.uid);

      allow create: if isAdmin() && request.resource.data.sentBy == request.auth.uid;
      allow delete: if isAdmin();
      allow update: if isAdmin();
    }

    // ---------- Settings ----------
    match /Settings/CommunityRules {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /Settings/AntiAbuse {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- Suggestions ----------
    match /Suggestions/{id} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
      allow update: if false;
    }

    // ---------- BugReports ----------
    match /BugReports/{id} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
      allow update: if false;
    }

    // Internal bookkeeping doc used by Cloud Functions for push idempotency.
    match /_pushEvents/{eventId} {
      allow read, write: if false; // functions use Admin SDK, bypasses rules
    }

    // ---------- Default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
